    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pdfkit": "^0.16.0",
    "pg": "^8.13.3",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.9",
    "@types/pdfkit": "^0.13.9",
    "@types/pg": "^8.11.11",
